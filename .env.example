# 复制为 .env 后填写，再执行: docker compose up -d --build
# cp .env.example .env

# ---------- 对外端口 ----------
BACKEND_PORT=8123
FRONTEND_PORT=8090

# ---------- 必填：OpenRouter API Key ----------
# 申请地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
SPRING_AI_OPENAI_API_KEY=${OPENROUTER_API_KEY}
SPRING_AI_DEFAULT_MODEL=qwen/qwen-plus

# ---------- 数据库 / 缓存 / 队列（生产请改成强密码）----------
MYSQL_ROOT_PASSWORD=ChangeMe_MySql_StrongPass1
REDIS_PASSWORD=ChangeMe_Redis_StrongPass1
RABBITMQ_DEFAULT_USER=ai_eval
RABBITMQ_DEFAULT_PASS=ChangeMe_Rabbit_StrongPass1

# ---------- 可选：腾讯云 COS（多模态图片上传；不配则图片上传不可用）----------
TENCENT_COS_ACCESS_KEY=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_COS_HOST=

# ---------- 可选 ----------
KNIFE4J_ENABLE=false

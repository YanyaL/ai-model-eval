# 复制为 .env 后填写，再执行: docker compose up -d --build
# cp .env.example .env

# ---------- 对外端口 ----------
BACKEND_PORT=8123
FRONTEND_PORT=8090

# ---------- 阶段2：Mock AI（默认开启，可不填真实 Key）----------
# true = 不调用真实大模型，返回演示流式回答
AI_MOCK_ENABLED=true
# 有真实 Key 后：填入下方，并把 AI_MOCK_ENABLED=false
OPENROUTER_API_KEY=sk-mock-disabled
SPRING_AI_OPENAI_API_KEY=${OPENROUTER_API_KEY}
SPRING_AI_DEFAULT_MODEL=qwen/qwen-plus

# ---------- 数据库 / 缓存 / 队列（生产请改成强密码）----------
MYSQL_ROOT_PASSWORD=ChangeMe_MySql_StrongPass1
REDIS_PASSWORD=ChangeMe_Redis_StrongPass1
RABBITMQ_DEFAULT_USER=ai_eval
RABBITMQ_DEFAULT_PASS=ChangeMe_Rabbit_StrongPass1

# ---------- 阶段3：本地上传（默认开启，可不配 COS）----------
STORAGE_LOCAL_ENABLED=true
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_BASE_URL=/api/files

# ---------- 可选：腾讯云 COS（配真实密钥后可关闭本地存储）----------
TENCENT_COS_ACCESS_KEY=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_COS_HOST=

# ---------- 可选 ----------
KNIFE4J_ENABLE=false
